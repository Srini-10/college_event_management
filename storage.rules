rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Event media: staff can read/write
    match /events/{eventId}/media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    // Guest photos
    match /events/{eventId}/guests/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    // Documents (contracts, booking confirmations)
    match /events/{eventId}/documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 20 * 1024 * 1024; // 20MB
    }

    // Receipts
    match /events/{eventId}/receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024; // 10MB
    }
  }
}
